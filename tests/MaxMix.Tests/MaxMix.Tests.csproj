<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0-windows because we transitively reference MaxMix.Audio which uses WASAPI. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MaxMix.Core\MaxMix.Core.csproj" />
    <ProjectReference Include="..\..\src\MaxMix.Serial\MaxMix.Serial.csproj" />
    <ProjectReference Include="..\..\src\MaxMix.Audio\MaxMix.Audio.csproj" />
    <ProjectReference Include="..\..\src\MaxMix.App\MaxMix.App.csproj" />
  </ItemGroup>

</Project>
