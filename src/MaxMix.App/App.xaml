<Application x:Class="MaxMix.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MaxMix.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <!--
        ShutdownMode=OnExplicitShutdown so closing the main window doesn't kill
        the app: the tray icon keeps it alive. Exit happens via the tray menu
        or explicit Application.Current.Shutdown() in code.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <!-- Dark theme palette -->
            <SolidColorBrush x:Key="BackgroundBrush"      Color="#FF1E1E1E" />
            <SolidColorBrush x:Key="SurfaceBrush"         Color="#FF2D2D30" />
            <SolidColorBrush x:Key="ForegroundBrush"      Color="#FFE6E6E6" />
            <SolidColorBrush x:Key="MutedForegroundBrush" Color="#FF9A9A9A" />
            <SolidColorBrush x:Key="AccentBrush"          Color="#FF0078D4" />
            <SolidColorBrush x:Key="ConnectedBrush"       Color="#FF2EC27E" />
            <SolidColorBrush x:Key="DisconnectedBrush"    Color="#FFE5484D" />
            <SolidColorBrush x:Key="ConnectingBrush"      Color="#FFF5A623" />

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:ZeroToVisibilityConverter x:Key="ZeroToVis" />

            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
                <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize"   Value="13" />
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
