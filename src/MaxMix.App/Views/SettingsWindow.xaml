<Window x:Class="MaxMix.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MaxMix Settings"
        Height="720" Width="560"
        MinHeight="620" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}">
    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="#FF3B3B40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FF35353A"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="#FF4A4A50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style x:Key="DarkComboToggleButton" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="1"
                                        Background="#FF2A2A2E"
                                        BorderBrush="#FF4A4A50"
                                        BorderThickness="1,0,0,0"/>

                                <Path Grid.Column="1"
                                      Width="10" Height="6"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 0 0 L 5 6 L 10 0 Z"
                                      Fill="{StaticResource ForegroundBrush}"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF35353A"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="#FF4A4A50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="MaxDropDownHeight" Value="260"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Style="{StaticResource DarkComboToggleButton}"/>

                            <ContentPresenter x:Name="ContentSite"
                                              Margin="12,0,40,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              SnapsToDevicePixels="True"
                                              IsHitTestVisible="False"/>

                            <TextBox x:Name="PART_EditableTextBox"
                                     Visibility="Hidden"
                                     Background="Transparent"
                                     Foreground="{TemplateBinding Foreground}"
                                     BorderThickness="0"
                                     Margin="12,0,40,0"
                                     VerticalContentAlignment="Center"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border x:Name="DropDownBorder"
                                        Background="#FF2A2A2E"
                                        BorderBrush="#FF4A4A50"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,4,0,0">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="36"/>
                            </Trigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemRoot"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="#FF404046"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Section}" Text="GENERAL"/>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Startup and behavior"/>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="These settings control how MaxMix starts, sleeps, and behaves in the tray."/>

                        <CheckBox Content="Start with Windows" IsChecked="{Binding AutoStartWithWindows}"/>
                        <CheckBox Content="Open minimized to tray" IsChecked="{Binding StartMinimized}"/>
                        <CheckBox Content="Close button minimizes to tray" IsChecked="{Binding MinimizeToTray}"/>
                        <CheckBox Content="Continuous scroll (knob wraps around)" IsChecked="{Binding ContinuousScroll}"/>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="Knob acceleration"/>
                            <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100"
                                    Value="{Binding AccelerationPercentage}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource ValueText}"
                                       Text="{Binding AccelerationPercentage}"/>

                            <Label Grid.Row="1" Grid.Column="0" Content="Sleep after (seconds)"/>
                            <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="120"
                                    Value="{Binding SleepAfterSeconds}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueText}"
                                       Text="{Binding SleepAfterSeconds}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Section}" Text="DEVICE"/>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Connection"/>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="Pick the last COM port MaxMix should try first. You can refresh if you reconnect the device."/>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0" Content="Preferred COM port"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailablePorts}"
                                      SelectedItem="{Binding SelectedPort}" Margin="0,2,8,2"/>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                    Content="Refresh" Command="{Binding RefreshPortsCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Section}" Text="LIGHTING"/>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Application ring colors"/>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="The current firmware supports static palettes here. In application mode the ring uses only the low-volume and high-volume colors, so you do not need to manage twelve sliders anymore."/>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0" Content="Preset"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailablePresets}"
                                      SelectedItem="{Binding SelectedPreset}" Margin="0,2,8,2"/>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                    Content="Apply" Command="{Binding ApplyPresetCommand}"/>
                        </Grid>

                        <Border Background="#FF262629" BorderBrush="#FF3B3B40" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Idle lighting" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource HintText}"
                                           Margin="0,2,0,8"
                                           Text="Instead of letting firmware sleep, the desktop can switch the ring to idle colors while the device is inactive. While this is enabled, firmware sleep is kept off so the ring stays awake."/>

                                <CheckBox Content="Enable idle lighting" IsChecked="{Binding IdleLightingEnabled}"/>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Idle after (seconds)"/>
                                    <Slider Grid.Row="0" Grid.Column="1" Minimum="5" Maximum="120"
                                            IsEnabled="{Binding IdleLightingEnabled}"
                                            Value="{Binding IdleLightingAfterSeconds}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource ValueText}"
                                                Text="{Binding IdleLightingAfterSeconds}"/>

                                    <Label Grid.Row="1" Grid.Column="0" Content="Idle preset"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2,8,2"
                                              IsEnabled="{Binding IdleLightingEnabled}"
                                              ItemsSource="{Binding AvailablePresets}"
                                              SelectedItem="{Binding SelectedIdlePreset}"/>
                                    <Button Grid.Row="1" Grid.Column="2"
                                            Style="{StaticResource SecondaryButton}"
                                            IsEnabled="{Binding IdleLightingEnabled}"
                                            Content="Apply"
                                            Margin="0,0,8,0"
                                            Command="{Binding ApplyIdlePresetCommand}"/>

                                    <Label Grid.Row="2" Grid.Column="0" Content="Idle mode"/>
                                    <Grid Grid.Row="2" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="48"/>
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0"
                                                  IsEnabled="{Binding IdleLightingEnabled}"
                                                  ItemsSource="{Binding IdleLightingModes}"
                                                  SelectedItem="{Binding SelectedIdleLightingMode}"/>

                                        <Slider Grid.Column="2" Minimum="1" Maximum="10"
                                                IsEnabled="{Binding IdleLightingEnabled}"
                                                Value="{Binding IdleLightingSpeed}"/>
                                        <TextBlock Grid.Column="3" Style="{StaticResource ValueText}"
                                                   Text="{Binding IdleLightingSpeed}"/>
                                    </Grid>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#FF1F1F22" BorderBrush="#FF3B3B40" BorderThickness="1" CornerRadius="6" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Idle color A" FontWeight="SemiBold"/>
                                            <TextBlock Style="{StaticResource HintText}" Text="Static/Pulse start color, Fade origin" Margin="0,2,0,8"/>
                                            <Border Height="26" CornerRadius="4" Background="{Binding IdleColorAHex}"/>
                                            <TextBlock Margin="0,8,0,0" Style="{StaticResource ValueText}" Text="{Binding IdleColorAHex}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="#FF1F1F22" BorderBrush="#FF3B3B40" BorderThickness="1" CornerRadius="6" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Idle color B" FontWeight="SemiBold"/>
                                            <TextBlock Style="{StaticResource HintText}" Text="Static/Pulse end color, Fade target" Margin="0,2,0,8"/>
                                            <Border Height="26" CornerRadius="4" Background="{Binding IdleColorBHex}"/>
                                            <TextBlock Margin="0,8,0,0" Style="{StaticResource ValueText}" Text="{Binding IdleColorBHex}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Expander Header="Advanced idle colors">
                                    <StackPanel Margin="0,10,0,0">
                                        <Border Background="#FF262629" BorderBrush="#FF3B3B40" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="140"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                                           Text="Idle color A" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                                <Label Grid.Row="1" Grid.Column="0" Content="Red"/>
                                                <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding IdleColorAR}"/>
                                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding IdleColorAR}"/>

                                                <Label Grid.Row="2" Grid.Column="0" Content="Green"/>
                                                <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding IdleColorAG}"/>
                                                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding IdleColorAG}"/>

                                                <Label Grid.Row="3" Grid.Column="0" Content="Blue"/>
                                                <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding IdleColorAB}"/>
                                                <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding IdleColorAB}"/>

                                                <Border Grid.Row="1" Grid.Column="4" Grid.RowSpan="3"
                                                        Background="#FF1F1F22"
                                                        BorderBrush="#FF3B3B40"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="10">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Preview" FontWeight="SemiBold"/>
                                                        <Border Height="28" Margin="0,8,0,0" CornerRadius="4" Background="{Binding IdleColorAHex}"/>
                                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource ValueText}" Text="{Binding IdleColorAHex}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Border Background="#FF262629" BorderBrush="#FF3B3B40" BorderThickness="1" CornerRadius="6" Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="140"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                                           Text="Idle color B" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                                <Label Grid.Row="1" Grid.Column="0" Content="Red"/>
                                                <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding IdleColorBR}"/>
                                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding IdleColorBR}"/>

                                                <Label Grid.Row="2" Grid.Column="0" Content="Green"/>
                                                <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding IdleColorBG}"/>
                                                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding IdleColorBG}"/>

                                                <Label Grid.Row="3" Grid.Column="0" Content="Blue"/>
                                                <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding IdleColorBB}"/>
                                                <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding IdleColorBB}"/>

                                                <Border Grid.Row="1" Grid.Column="4" Grid.RowSpan="3"
                                                        Background="#FF1F1F22"
                                                        BorderBrush="#FF3B3B40"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="10">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Preview" FontWeight="SemiBold"/>
                                                        <Border Height="28" Margin="0,8,0,0" CornerRadius="4" Background="{Binding IdleColorBHex}"/>
                                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource ValueText}" Text="{Binding IdleColorBHex}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#FF262629" BorderBrush="#FF3B3B40" BorderThickness="1" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Volume minimum" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource HintText}" Text="Quiet end of the ring" Margin="0,2,0,8"/>
                                    <Border Height="26" CornerRadius="4" Background="{Binding VolumeMinHex}"/>
                                    <TextBlock Margin="0,8,0,0" Style="{StaticResource ValueText}" Text="{Binding VolumeMinHex}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#FF262629" BorderBrush="#FF3B3B40" BorderThickness="1" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Volume maximum" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource HintText}" Text="Loud end of the ring" Margin="0,2,0,8"/>
                                    <Border Height="26" CornerRadius="4" Background="{Binding VolumeMaxHex}"/>
                                    <TextBlock Margin="0,8,0,0" Style="{StaticResource ValueText}" Text="{Binding VolumeMaxHex}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Margin="0,12,0,0" Style="{StaticResource HintText}"
                                   Text="Sleep on the current firmware always turns the LEDs off completely. Presets only affect the active application ring colors."/>

                        <Expander Header="Advanced custom colors">
                            <StackPanel Margin="0,10,0,0">
                                <Border Background="#FF262629" BorderBrush="#FF3B3B40" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="48"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                                   Text="Volume minimum" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                        <Label Grid.Row="1" Grid.Column="0" Content="Red"/>
                                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding VolumeMinR}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding VolumeMinR}"/>

                                        <Label Grid.Row="2" Grid.Column="0" Content="Green"/>
                                        <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding VolumeMinG}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding VolumeMinG}"/>

                                        <Label Grid.Row="3" Grid.Column="0" Content="Blue"/>
                                        <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding VolumeMinB}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding VolumeMinB}"/>
                                    </Grid>
                                </Border>

                                <Border Background="#FF262629" BorderBrush="#FF3B3B40" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="48"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                                   Text="Volume maximum" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                        <Label Grid.Row="1" Grid.Column="0" Content="Red"/>
                                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding VolumeMaxR}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding VolumeMaxR}"/>

                                        <Label Grid.Row="2" Grid.Column="0" Content="Green"/>
                                        <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding VolumeMaxG}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding VolumeMaxG}"/>

                                        <Label Grid.Row="3" Grid.Column="0" Content="Blue"/>
                                        <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding VolumeMaxB}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding VolumeMaxB}"/>
                                    </Grid>
                                </Border>

                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}"
                       Foreground="{StaticResource MutedForegroundBrush}"
                       VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}"
                        Content="Reset"
                        Margin="0,0,8,0"
                        Command="{Binding ResetCommand}"/>
                <Button Style="{StaticResource PrimaryButton}"
                        Content="Save"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
